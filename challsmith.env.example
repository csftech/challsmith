# challsmith install config. Copy to challsmith.env and edit.

# CTFd administrator account (all required).
CTFD_ADMIN_NAME=admin
CTFD_ADMIN_EMAIL=admin@example.com
CTFD_ADMIN_PASSWORD=change-me

# CTFd SECRET_KEY. Leave empty to auto-generate at install.
CTFD_SECRET_KEY=

# MariaDB password. Leave empty to auto-generate at install.
CTFD_DB_PASSWORD=

# Per-user mana limit in chall-manager. Default 5.
CM_MANA_TOTAL=5

# Optional proxy, applied to apt and the Docker daemon.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Optional Docker Hub proxy address, written to daemon.json registry-mirrors.
DOCKER_REGISTRY_MIRROR=

# Optional Go module proxy, used when building scenarios.
GOPROXY=

# Pulumi docker provider plugin tarball: http(s) URL or absolute local path.
# Default (empty): the GitHub release asset for the version in scenarios/go.mod
# (pulumi-docker sdk, currently v5.3.0; the plugin version must match it).
# A URL is verified against the release checksums file next to it; for a local
# path, set PULUMI_DOCKER_CHECKSUMS to a local pulumi-docker_<ver>_checksums.txt
# (otherwise verification is skipped with a warning).
PULUMI_DOCKER_PLUGIN=
PULUMI_DOCKER_CHECKSUMS=

# oras release tarball (v1.4.0): http(s) URL or absolute local path.
# Default (empty): the GitHub release. ORAS_CHECKSUMS works like PULUMI_DOCKER_CHECKSUMS.
ORAS_TARBALL=
ORAS_CHECKSUMS=

# Burp Suite Community (Linux) download URL. Default is the PortSwigger one.
BURP_DOWNLOAD_URL='https://portswigger.net/burp/releases/download?product=community&type=Linux'
