# challsmith install config. Copy to challsmith.env and edit.

# CTFd administrator account (all required).
CTFD_ADMIN_NAME=admin
CTFD_ADMIN_EMAIL=admin@example.com
CTFD_ADMIN_PASSWORD=change-me

# The web app also logs in to CTFd with CTFD_ADMIN_NAME and CTFD_ADMIN_PASSWORD above:
# if you change the administrator password in CTFd, change it here too.

# Authoring web app login (WEB_ADMIN_PASSWORD is required).
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=
# Host names (with port) the web app answers to; add the name you use to reach the VM. Default:
# WEB_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# Web app PostgreSQL password. Leave empty to auto-generate at install.
APP_DB_PASSWORD=

# CTFd SECRET_KEY. Leave empty to auto-generate at install.
CTFD_SECRET_KEY=

# MariaDB password. Leave empty to auto-generate at install.
CTFD_DB_PASSWORD=

# Per-user mana limit in chall-manager. Default 5.
CM_MANA_TOTAL=5

# Optional proxy, applied to apt, the Docker daemon, the install-time GitHub release
# downloads and the golang build container. Never passed to service or challenge containers.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Optional Docker Hub proxy address, written to daemon.json registry-mirrors.
DOCKER_REGISTRY_MIRROR=

# Optional company Go module mirror (Artifactory/Nexus style) used when building scenarios,
# e.g. GOPROXY=https://artifactory.example/api/go/go-remote
# With a mirror nothing needs storage.googleapis.com. If the mirror host is internal,
# add it to NO_PROXY above.
GOPROXY=

# Optional checksum database for the scenario build, e.g.
# GOSUMDB="sum.golang.org https://<mirror>/sumdb/sum.golang.org" when the mirror proxies it,
# or "off" only if the company requires it. Empty: Go's default.
GOSUMDB=

# Pulumi docker provider plugin tarball: http(s) URL or absolute local path.
# Default (empty): the GitHub release asset for the version in infra/scenarios/go.mod
# (pulumi-docker sdk, currently v5.3.0; the plugin version must match it).
# A URL is verified against the release checksums file next to it; for a local
# path, set PULUMI_DOCKER_CHECKSUMS to a local pulumi-docker_<ver>_checksums.txt
# (otherwise verification is skipped with a warning).
PULUMI_DOCKER_PLUGIN=
PULUMI_DOCKER_CHECKSUMS=

# oras release tarball (v1.4.0): http(s) URL or absolute local path.
# Default (empty): the GitHub release. ORAS_CHECKSUMS works like PULUMI_DOCKER_CHECKSUMS.
ORAS_TARBALL=
ORAS_CHECKSUMS=

# Burp Suite (merged Professional/Community installer, runs as Community without a licence).
# BURP_VERSION: version to install (default 2026.11.2, pinned in install.sh).
# BURP_DOWNLOAD_URL: override the PortSwigger URL built from BURP_VERSION.
# BURP_SHA256: expected SHA-256 of the installer. Built in for the default version; with a
# custom BURP_DOWNLOAD_URL or another BURP_VERSION and an empty value, verification is skipped
# with a warning. A mismatch aborts.
BURP_VERSION=
BURP_DOWNLOAD_URL=
BURP_SHA256=
